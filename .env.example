# ── Database ────────────────────────────────────────────────
POSTGRES_USER=lab
POSTGRES_PASSWORD=lab_dev_password
POSTGRES_DB=ailab
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
DATABASE_URL=postgresql+asyncpg://lab:lab_dev_password@postgres:5432/ailab
# Sync URL used by Alembic
DATABASE_URL_SYNC=postgresql+psycopg://lab:lab_dev_password@postgres:5432/ailab

# ── Redis ───────────────────────────────────────────────────
REDIS_URL=redis://redis:6379/0

# ── Backend ─────────────────────────────────────────────────
BACKEND_HOST=0.0.0.0
BACKEND_PORT=8000
LOG_LEVEL=INFO
CORS_ORIGINS=http://localhost:3000

# Face recognition thresholds
FACE_MATCH_THRESHOLD=0.55
FACE_UNKNOWN_THRESHOLD=0.45
VISIT_DEBOUNCE_MINUTES=30

# Email (MVP: mock — logs token to console)
EMAIL_BACKEND=mock
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
EMAIL_FROM=noreply@lab.example.com
PUBLIC_BASE_URL=http://localhost:3000

# Optional email domain whitelist (comma-separated, empty = allow all)
EMAIL_DOMAIN_WHITELIST=

# ── Face service ────────────────────────────────────────────
# mock = random embeddings + synthetic events; insightface = real (later)
FACE_SERVICE_MODE=mock
BACKEND_WS_URL=ws://backend:8000/ws/face-service
CAMERA_SOURCE=0
FRAME_INTERVAL_MS=200
MOCK_EVENT_INTERVAL_S=8
# Fraction of mock visits that are "returning" (recognized) vs unknown. 0.0 = always unknown.
MOCK_KNOWN_RATIO=0.5

# ── Frontend ────────────────────────────────────────────────
NEXT_PUBLIC_BACKEND_URL=http://localhost:8000
NEXT_PUBLIC_BACKEND_WS_URL=ws://localhost:8000/ws/kiosk
