[Unit]
Description=AI Lab Giriş Sistemi (docker compose stack)
Documentation=https://github.com/anthropics/ailab-kiosk
After=docker.service network-online.target
Requires=docker.service
Wants=network-online.target

[Service]
Type=oneshot
RemainAfterExit=yes
# Project directory is filled in by deploy/install.sh.
WorkingDirectory=__PROJECT_DIR__
Environment=COMPOSE_PROJECT_NAME=ailab
ExecStart=/usr/bin/docker compose up -d
ExecStop=/usr/bin/docker compose down
# Initial start may build images / download InsightFace; give it plenty.
TimeoutStartSec=900

[Install]
WantedBy=multi-user.target
